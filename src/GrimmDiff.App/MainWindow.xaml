<Window x:Class="GrimmDiff.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GrimmDiff.App" Title="grimmdiff" Width="1440" Height="900" Background="{DynamicResource Background}" Foreground="{DynamicResource Primary}">
  <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Menu Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Height="32" Background="Transparent"><MenuItem Header="MENU" Style="{StaticResource MenuBarItem}"><MenuItem Header="Open repository" Command="{Binding OpenRepositoryCommand}"/><MenuItem Header="Clone" Command="{Binding CloneCommand}"/><Separator/><MenuItem Header="Language"><MenuItem Header="EN" IsCheckable="True" IsChecked="{Binding IsEnglish}"/><MenuItem Header="DE" IsCheckable="True" IsChecked="{Binding IsGerman}"/></MenuItem><MenuItem Header="Theme"><MenuItem Header="System" IsCheckable="True" IsChecked="{Binding IsSystemTheme}"/><MenuItem Header="Dark" IsCheckable="True" IsChecked="{Binding IsDarkTheme}"/><MenuItem Header="Light" IsCheckable="True" IsChecked="{Binding IsLightTheme}"/></MenuItem><MenuItem Header="Font"><MenuItem Header="Cascadia Code" IsCheckable="True" IsChecked="{Binding IsCascadiaCode}"/><MenuItem Header="Verdana" IsCheckable="True" IsChecked="{Binding IsVerdana}"/></MenuItem></MenuItem></Menu>
  <Grid Grid.Row="1" Margin="32,8,32,32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,24"><TextBlock Text="grimmdiff" FontSize="28" VerticalAlignment="Center"/></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="220"/><ColumnDefinition Width="6"/><ColumnDefinition Width="440" MinWidth="280"/><ColumnDefinition Width="*" MinWidth="320"/></Grid.ColumnDefinitions>
      <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="160"/></Grid.RowDefinitions><TextBlock Text="REPOSITORY" Foreground="{DynamicResource Secondary}" FontSize="12"/><TextBlock Grid.Row="1" Text="{Binding RepositoryName}" TextTrimming="CharacterEllipsis" Margin="0,8,0,24"/><Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="Current changes" Command="{Binding ShowCurrentCommand}" HorizontalAlignment="Left"/><TextBlock Grid.Row="1" Text="HISTORICAL COMMITS" Foreground="{DynamicResource Secondary}" FontSize="12" Margin="0,24,0,8"/><ListBox Grid.Row="2" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedCommit}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><ItemsControl ItemsSource="{Binding SubjectParts}" ClipToBounds="True"><ItemsControl.ItemsPanel><ItemsPanelTemplate><DockPanel LastChildFill="True"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.Resources><DataTemplate DataType="{x:Type local:PlainCommitSubjectPart}"><TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"/></DataTemplate><DataTemplate DataType="{x:Type local:JiraCommitSubjectPart}"><Button Content="{Binding Text}" Style="{StaticResource IssueLink}" Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Url}"/></DataTemplate></ItemsControl.Resources></ItemsControl></DataTemplate></ListBox.ItemTemplate></ListBox></Grid><TextBlock Grid.Row="3" Text="RECENT REPOSITORIES" Foreground="{DynamicResource Secondary}" FontSize="12" Margin="0,16,0,8"/><ListBox Grid.Row="4" ItemsSource="{Binding RecentRepositories}" SelectedItem="{Binding SelectedRecent}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{DynamicResource Border}" ShowsPreview="True" Cursor="SizeWE"/>
      <Border Grid.Column="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,1,0" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding ViewTitle}" TextTrimming="CharacterEllipsis" FontSize="20"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0"><ItemsControl ItemsSource="{Binding Groups}"><ItemsControl.ItemTemplate><DataTemplate><Expander IsExpanded="False" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,8"><Expander.Header><TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" FontSize="14"/></Expander.Header><ItemsControl ItemsSource="{Binding Files}" Margin="16,4,0,2"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource FileLink}" Command="{Binding DataContext.SelectFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Stretch"><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
      <Border Grid.Column="3" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="CODE" Foreground="{DynamicResource Secondary}" FontSize="12"/><ListBox Grid.Row="1" ItemsSource="{Binding DiffLines}" BorderThickness="0" Background="Transparent" FontSize="13" Margin="0,16,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="{Binding Background}" Padding="2,0" ClipToBounds="True"><ItemsControl ItemsSource="{Binding Tokens}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" xml:space="preserve"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource Secondary}" Margin="0,16,0,0"/>
  </Grid></Grid>
</Window>
