<Window x:Class="GrimmDiff.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GrimmDiff" Width="1440" Height="900" Background="{DynamicResource Background}" Foreground="{DynamicResource Primary}">
  <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,24"><TextBlock Text="GRIMMDIFF" FontFamily="Cascadia Code" FontSize="28" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><StackPanel Orientation="Horizontal" Margin="0,0,16,0"><ToggleButton Content="EN" IsChecked="{Binding IsEnglish}"/><ToggleButton Content="DE" IsChecked="{Binding IsGerman}" Margin="-1,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,16,0"><ToggleButton Content="SYS" IsChecked="{Binding IsSystemTheme}"/><ToggleButton Content="DARK" IsChecked="{Binding IsDarkTheme}" Margin="-1,0,0,0"/><ToggleButton Content="LIGHT" IsChecked="{Binding IsLightTheme}" Margin="-1,0,0,0"/></StackPanel><Button Content="Open repository" Command="{Binding OpenRepositoryCommand}"/><Button Content="Clone" Command="{Binding CloneCommand}"/></StackPanel></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="440"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,1,0" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="160"/></Grid.RowDefinitions><TextBlock Text="REPOSITORY" Foreground="{DynamicResource Secondary}" FontSize="12"/><TextBlock Grid.Row="1" Text="{Binding RepositoryPath}" TextWrapping="Wrap" Margin="0,8,0,24"/><StackPanel Grid.Row="2"><Button Content="Current changes" Command="{Binding ShowCurrentCommand}" HorizontalAlignment="Left"/><TextBlock Text="HISTORICAL COMMITS" Foreground="{DynamicResource Secondary}" FontSize="12" Margin="0,24,0,8"/><ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedCommit}" DisplayMemberPath="Subject" BorderThickness="0" Background="Transparent"/></StackPanel><TextBlock Grid.Row="3" Text="RECENT REPOSITORIES" Foreground="{DynamicResource Secondary}" FontSize="12" Margin="0,16,0,8"/><ListBox Grid.Row="4" ItemsSource="{Binding RecentRepositories}" SelectedItem="{Binding SelectedRecent}" BorderThickness="0" Background="Transparent"/></Grid></Border>
      <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,1,0" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding ViewTitle}" FontSize="20"/><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0"><ItemsControl ItemsSource="{Binding Groups}"><ItemsControl.ItemTemplate><DataTemplate><Expander IsExpanded="True" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,12"><Expander.Header><TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="16"/></Expander.Header><ItemsControl ItemsSource="{Binding Files}" Margin="16,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Path}" Command="{Binding DataContext.SelectFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left" BorderThickness="0" Padding="0,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
      <Border Grid.Column="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="CODE" Foreground="{DynamicResource Secondary}" FontSize="12"/><ListBox Grid.Row="1" ItemsSource="{Binding DiffLines}" BorderThickness="0" Background="Transparent" FontFamily="Cascadia Code" FontSize="13" Margin="0,16,0,0"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" xml:space="preserve"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource Secondary}" Margin="0,16,0,0"/>
  </Grid>
</Window>
