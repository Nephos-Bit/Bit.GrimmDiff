<Application x:Class="GrimmDiff.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Background" Color="#080808"/><SolidColorBrush x:Key="Surface" Color="#101010"/><SolidColorBrush x:Key="Primary" Color="#ECECEC"/><SolidColorBrush x:Key="Secondary" Color="#A0A0A0"/><SolidColorBrush x:Key="Border" Color="#303030"/><SolidColorBrush x:Key="Active" Color="#00B83A"/><SolidColorBrush x:Key="Critical" Color="#FF3B0A"/>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource Primary}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="44"/><Setter Property="FontFamily" Value="Cascadia Code"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource Primary}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Padding" Value="8"/><Setter Property="FontFamily" Value="Cascadia Code"/></Style>
    <Style TargetType="ToggleButton"><Setter Property="Foreground" Value="{DynamicResource Secondary}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontFamily" Value="Cascadia Code"/><Setter Property="FontSize" Value="12"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Primary}"/><Setter Property="BorderBrush" Value="{DynamicResource Active}"/></Trigger></Style.Triggers></Style>
  </Application.Resources>
</Application>
