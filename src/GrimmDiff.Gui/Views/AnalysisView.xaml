<UserControl x:Class="GrimmDiff.Gui.Views.AnalysisView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GrimmDiff.Gui.Controls"
             Foreground="{DynamicResource Primary}">
    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Command="{Binding AnalyzeWithAiCommand}"
                            ToolTip="{Binding AnalyzeButtonText}">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Data="M4,12 A8,8 0 0 1 18,6 M18,6 L18,2 M18,6 L14,6 M20,12 A8,8 0 0 1 6,18 M6,18 L6,22 M6,18 L10,18"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent"
                              StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding CancelAnalysisCommand}"
                            ToolTip="{Binding CancelButtonText}" Foreground="{DynamicResource Critical}">
                        <Path Width="16" Height="16" Stretch="Uniform" Data="M6,6 L18,18 M18,6 L6,18"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent"
                              StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                    </Button>
                </StackPanel>
                <controls:ReviewMascotControl DockPanel.Dock="Left" Margin="0,0,8,0"
                                           VerticalAlignment="Center" IsAnalyzing="{Binding IsAnalyzing}"
                                           Visibility="{Binding MascotVisibility}" Variant="{Binding SelectedMascotId}"
                                           OutlineBrush="{DynamicResource MascotOutline}"
                                           BodyBrush="{DynamicResource MascotBody}"
                                           AccentBrush="{DynamicResource MascotAccent}"
                                           HighlightBrush="{DynamicResource MascotHighlight}" />
                <Grid MinWidth="0" ClipToBounds="True" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding ViewTitle}" TextTrimming="CharacterEllipsis" FontSize="20">
                        <TextBlock.ToolTip>
                            <ToolTip MaxWidth="440"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <TextBlock Text="{Binding ViewTitle}" TextWrapping="Wrap" />
                            </ToolTip>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBlock Grid.Row="1" Text="{Binding AnalysisProgressText}"
                               Foreground="{DynamicResource Secondary}" FontSize="12" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.ToolTip>
                            <ToolTip MaxWidth="440"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <TextBlock Text="{Binding AnalysisProgressText}" TextWrapping="Wrap" />
                            </ToolTip>
                        </TextBlock.ToolTip>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
            <ProgressBar Grid.Row="1" Height="2" IsIndeterminate="True"
                         Foreground="{DynamicResource Active}" Background="{DynamicResource Border}"
                         BorderThickness="0" Margin="0,8,0,0">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox Grid.Row="0" ItemsSource="{Binding Groups}" BorderThickness="0"
                         Background="Transparent" ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="False" BorderBrush="{DynamicResource Border}"
                                      BorderThickness="0,0,0,1" Padding="0,8"
                                      HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Margin="0,4,8,0"
                                                 AutomationProperties.Name="{Binding ReviewAccessibilityLabel}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasReview}"
                                                                Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsReviewGood}"
                                                                Value="True">
                                                            <Setter Property="Fill"
                                                                    Value="{DynamicResource Positive}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsReviewOk}"
                                                                Value="True">
                                                            <Setter Property="Fill"
                                                                    Value="{DynamicResource Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsReviewWarning}"
                                                                Value="True">
                                                            <Setter Property="Fill"
                                                                    Value="{DynamicResource Critical}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                                       FontSize="14" />
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{DynamicResource Secondary}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <ListBox ItemsSource="{Binding Files}" MaxHeight="260" Margin="16,4,0,2"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource FileLink}"
                                                    Command="{Binding DataContext.SelectFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Stretch">
                                                <TextBlock Text="{Binding Path}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Expander>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                        Margin="0,16,0,0" Padding="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding AnalysisSourceLabel}"
                                   Foreground="{DynamicResource Secondary}"
                                   FontSize="11" />
                        <TextBlock Text="{Binding Account.StatusMessage}"
                                   Foreground="{DynamicResource Secondary}"
                                   FontSize="11" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding AiDisclosureText}"
                                   Foreground="{DynamicResource CodeComment}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
