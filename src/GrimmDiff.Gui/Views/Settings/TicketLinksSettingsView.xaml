<UserControl x:Class="GrimmDiff.Gui.TicketLinksSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="48">
        <TextBlock Text="TICKET-VERLINKUNG" FontSize="20" Margin="0,0,0,24" />
        <TextBlock Text="ANBIETER" Foreground="{DynamicResource Secondary}" FontSize="12" />
        <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" Margin="0,8,0,24" Width="260" HorizontalAlignment="Left" />
        <TextBlock Text="BASIS-URL" Foreground="{DynamicResource Secondary}" FontSize="12" />
        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,8" Width="520" HorizontalAlignment="Left" />
        <TextBlock Text="ERKENNUNGSMUSTER" Foreground="{DynamicResource Secondary}" FontSize="12" Margin="0,16,0,0" />
        <TextBox Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,8" Width="520" HorizontalAlignment="Left" />
        <TextBlock Text="Bei Custom erforderlich, sonst optional. Ein eigenes Muster benötigt die Gruppe (?&lt;id&gt;...)."
                   Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" MaxWidth="520" />
        <TextBlock Text="{Binding ConfigurationHint}" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" MaxWidth="520" />
    </StackPanel>
</UserControl>
