<UserControl x:Class="GrimmDiff.Gui.Views.Settings.AiPromptSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codex="clr-namespace:GrimmDiff.Data.Adapters.Codex;assembly=GrimmDiff.Data">
    <UserControl.Resources>
        <Style x:Key="WikiEyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="WikiLead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="WikiBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="24" />
        </Style>
        <Style x:Key="WikiHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="48">
        <TextBlock Text="{Binding Text[AiWikiEyebrow]}" Style="{StaticResource WikiEyebrow}" />
        <TextBlock Text="{Binding Text[AiPrompt]}" FontSize="48" FontWeight="Normal"
                   TextWrapping="Wrap" Margin="0,0,0,16" />
        <TextBlock Text="{Binding Text[AiWikiIntro]}" Style="{StaticResource WikiBody}" Margin="0,0,0,48" />

        <TextBlock Text="{Binding Text[AiWikiProcessTitle]}" Style="{StaticResource WikiHeading}" />
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="01" Style="{StaticResource WikiEyebrow}" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Text[AiWikiInputTitle]}" Style="{StaticResource WikiEyebrow}" />
                <TextBlock Text="{Binding Text[AiWikiInputSummary]}" Style="{StaticResource WikiLead}" />
                <TextBlock Text="{Binding Text[AiWikiInput]}" Style="{StaticResource WikiBody}" Margin="0,16,0,0" />
            </StackPanel>
        </Grid>
        <Border Height="1" Background="{DynamicResource Border}" Margin="0,32,0,32" />
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="02" Style="{StaticResource WikiEyebrow}" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Text[AiWikiGroupingTitle]}" Style="{StaticResource WikiEyebrow}" />
                <TextBlock Text="{Binding Text[AiWikiGroupingSummary]}" Style="{StaticResource WikiLead}" />
                <TextBlock Text="{Binding Text[AiWikiGrouping]}" Style="{StaticResource WikiBody}" Margin="0,16,0,0" />
            </StackPanel>
        </Grid>
        <Border Height="1" Background="{DynamicResource Border}" Margin="0,32,0,32" />
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="03" Style="{StaticResource WikiEyebrow}" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Text[AiWikiReviewTitle]}" Style="{StaticResource WikiEyebrow}" />
                <TextBlock Text="{Binding Text[AiWikiReviewSummary]}" Style="{StaticResource WikiLead}" />
                <TextBlock Text="{Binding Text[AiWikiReview]}" Style="{StaticResource WikiBody}" Margin="0,16,0,24" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Positive}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1" Text="{Binding Text[AiWikiReviewGood]}" Style="{StaticResource WikiBody}" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Warning}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1" Text="{Binding Text[AiWikiReviewOk]}" Style="{StaticResource WikiBody}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Critical}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1" Text="{Binding Text[AiWikiReviewWarning]}" Style="{StaticResource WikiBody}" />
                </Grid>
            </StackPanel>
        </Grid>

        <Border Height="1" Background="{DynamicResource Border}" Margin="0,48,0,48" />
        <TextBlock Text="{Binding Text[AiWikiFormatTitle]}" Style="{StaticResource WikiHeading}" />
        <TextBlock Text="{Binding Text[AiWikiFormatSummary]}" Style="{StaticResource WikiLead}" Margin="0,0,0,16" />
        <TextBlock Text="{Binding Text[AiWikiFormat]}" Style="{StaticResource WikiBody}" Margin="0,0,0,24" />
        <TextBox Text="{Binding ResponseExample, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="Cascadia Code" FontSize="14" Padding="16" Background="{DynamicResource Surface}"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
        <TextBlock Text="{Binding Text[AiWikiValidation]}" Style="{StaticResource WikiBody}" Margin="0,24,0,0" />

        <Border Height="1" Background="{DynamicResource Border}" Margin="0,48,0,48" />
        <TextBlock Text="{Binding Text[AiWikiLimitsTitle]}" Style="{StaticResource WikiHeading}" />
        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,1" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="16">
                    <TextBlock Text="1" FontSize="32" />
                    <TextBlock Text="{Binding Text[AiWikiMinimumGroupLabel]}" Style="{StaticResource WikiEyebrow}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="16">
                    <TextBlock Text="{Binding MaximumSectionCharacters}" FontSize="32" />
                    <TextBlock Text="{Binding Text[AiWikiMaximumSectionLabel]}" Style="{StaticResource WikiEyebrow}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="16">
                    <TextBlock Text="{Binding MaximumTransferCharacters}" FontSize="32" />
                    <TextBlock Text="{Binding Text[AiWikiMaximumTransferLabel]}" Style="{StaticResource WikiEyebrow}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="16">
                    <TextBlock Text="{Binding MaximumParts}" FontSize="32" />
                    <TextBlock Text="{Binding Text[AiWikiMaximumPartsLabel]}" Style="{StaticResource WikiEyebrow}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="0" Grid.RowSpan="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" />
                <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" />
            </Grid>
        </Border>
        <TextBlock Text="{Binding LimitsDescription}" Style="{StaticResource WikiBody}" />

        <Border Height="1" Background="{DynamicResource Border}" Margin="0,48,0,48" />
        <TextBlock Text="{Binding Text[AiWikiFallbackTitle]}" Style="{StaticResource WikiHeading}" />
        <TextBlock Text="{Binding Text[AiWikiFallbackSummary]}" Style="{StaticResource WikiLead}" Margin="0,0,0,16" />
        <TextBlock Text="{Binding Text[AiWikiFallback]}" Style="{StaticResource WikiBody}" />

        <Border Height="1" Background="{DynamicResource Border}" Margin="0,48,0,48" />
        <TextBlock Text="{Binding Text[AiWikiPromptTitle]}" Style="{StaticResource WikiHeading}" />
        <TextBlock Text="{Binding Text[AiWikiPromptSummary]}" Style="{StaticResource WikiLead}" Margin="0,0,0,16" />
        <TextBlock Text="{Binding Text[AiWikiPromptNote]}" Style="{StaticResource WikiBody}" Margin="0,0,0,24" />
        <TextBox Text="{x:Static codex:CodexCliPromptInstructions.Grouping}" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" FontFamily="Cascadia Code" FontSize="14" Padding="16"
                 Background="{DynamicResource Surface}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
    </StackPanel>
</UserControl>
