<UserControl x:Class="GrimmDiff.Gui.Views.Settings.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:GrimmDiff.Gui.ViewModels"
             xmlns:settings="clr-namespace:GrimmDiff.Gui.Views.Settings">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type viewModels:AppearanceSettingsViewModel}"><settings:AppearanceSettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:MascotSettingsViewModel}"><settings:MascotSettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AiAccountSettingsViewModel}"><settings:AiAccountSettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AiPrivacySettingsViewModel}"><settings:AiPrivacySettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AiPromptSettingsViewModel}"><settings:AiPromptSettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TicketLinksSettingsViewModel}"><settings:TicketLinksSettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AboutSettingsViewModel}"><settings:AboutSettingsView /></DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,1,0">
            <Button Style="{StaticResource IconButton}" Command="{Binding BackToWorkspaceCommand}" VerticalAlignment="Bottom"
                    ToolTip="{Binding Text[Back]}" AutomationProperties.Name="{Binding Text[Back]}">
                <Path Width="16" Height="16" Stretch="Uniform" Data="M15,4 L7,12 L15,20"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" Fill="Transparent" StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
            </Button>
        </Border>
        <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,1,0" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Secondary}" FontSize="12" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Pages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" HorizontalContentAlignment="Left" Padding="8,6">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="NavigationBackground" Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <TextBlock x:Name="Label" Text="{Binding Title}"
                                                                                   Foreground="{TemplateBinding Foreground}"
                                                                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="NavigationBackground" Property="Background" Value="{DynamicResource SurfaceRaised}" />
                                                                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                            <Setter TargetName="NavigationBackground" Property="Background" Value="{DynamicResource SurfaceRaised}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Opacity" Value="0.5" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Active}" /></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="{Binding Title}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Border Grid.Column="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding SelectedPage}" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
