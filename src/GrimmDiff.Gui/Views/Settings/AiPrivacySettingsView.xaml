<UserControl x:Class="GrimmDiff.Gui.AiPrivacySettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="48">
        <TextBlock Text="{Binding Text[PrivacyAndApprovals]}" FontSize="20" Margin="0,0,0,24" />
        <TextBlock Text="{Binding Text[AiRiskNotice]}" Foreground="{DynamicResource Secondary}" FontSize="12" />
        <Button Content="{Binding Text[ShowRiskNotice]}" Command="{Binding ShowRiskNoticeCommand}" HorizontalAlignment="Left" Margin="0,8,0,24" />
        <TextBlock Text="{Binding Text[RepositoryApproval]}" Foreground="{DynamicResource Secondary}" FontSize="12" />
        <TextBlock Text="{Binding Text[RepositoryApprovalDescription]}" Foreground="{DynamicResource Secondary}" Margin="0,8,0,8" />
        <Button Content="{Binding Text[RevokeAiApproval]}" Command="{Binding RevokeApprovalCommand}" HorizontalAlignment="Left" Foreground="{DynamicResource Critical}" />
    </StackPanel>
</UserControl>
