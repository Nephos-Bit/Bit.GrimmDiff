<UserControl x:Class="GrimmDiff.Gui.Views.Settings.AppearanceSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="48">
        <TextBlock Text="{Binding Text[Appearance]}" FontSize="20" Margin="0,0,0,24" />
        <TextBlock Text="{Binding Text[Language]}" Foreground="{DynamicResource Secondary}" FontSize="12" />
        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Margin="0,8,0,24" Width="260" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Text[Theme]}" Foreground="{DynamicResource Secondary}" FontSize="12" />
        <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" Margin="0,8,0,24" Width="260" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Text[Font]}" Foreground="{DynamicResource Secondary}" FontSize="12" />
        <ComboBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont}" Margin="0,8,0,0" Width="260" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
