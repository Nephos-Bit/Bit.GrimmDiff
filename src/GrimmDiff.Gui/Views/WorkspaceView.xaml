<UserControl x:Class="GrimmDiff.Gui.Views.WorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GrimmDiff.Gui.Views"
             xmlns:controls="clr-namespace:GrimmDiff.Gui.Controls"
             Foreground="{DynamicResource Primary}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="300" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="440" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <views:RepositoryView Grid.Column="0" Grid.ColumnSpan="2" DataContext="{Binding Repository}" />
            <GridSplitter Grid.Column="2" Width="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource Border}" ShowsPreview="True" Cursor="SizeWE"
                          controls:GridSplitterWidthBindingBehaviorControl.TargetColumnIndex="1"
                          controls:GridSplitterWidthBindingBehaviorControl.PanelWidth="{Binding Repository.RepositoryPanelColumnWidth, Mode=TwoWay}">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Repository.IsRepositoryPanelExpanded}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>
            <views:AnalysisView Grid.Column="3" DataContext="{Binding Analysis}" />
            <GridSplitter Grid.Column="4" Width="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource Border}" ShowsPreview="True" Cursor="SizeWE" />
            <views:DiffDocumentView Grid.Column="5" DataContext="{Binding Diff}" />
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding Status.Message}" Foreground="{DynamicResource Secondary}"
                   Margin="0 5 0 0" />
    </Grid>
</UserControl>
