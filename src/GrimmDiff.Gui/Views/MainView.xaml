<Window x:Class="GrimmDiff.Gui.MainView" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GrimmDiff.Gui"
        Icon="/Assets/AppIcon.ico" Width="1440" Height="900" Background="{DynamicResource Background}"
        Foreground="{DynamicResource Primary}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="grimmdiff" FontSize="20" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ApplicationVersion, StringFormat=v{0}}" FontSize="12" Opacity="0.5"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <Menu Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                <MenuItem Header="Repository" Style="{StaticResource MenuBarItem}">
                    <MenuItem Header="Open repository" Command="{Binding OpenRepositoryCommand}" />
                    <MenuItem Header="Clone" Command="{Binding CloneCommand}" />
                </MenuItem>
                <MenuItem Header="AI" Style="{StaticResource MenuBarItem}">
                    <MenuItem Header="AI risk notice / KI-Risikohinweis" Command="{Binding ShowAiRiskNoticeCommand}" />
                    <MenuItem Header="Revoke AI approval" Command="{Binding RevokeAiApprovalCommand}" />
                </MenuItem>
                <MenuItem Header="View" Style="{StaticResource MenuBarItem}">
                    <MenuItem Header="Language">
                        <MenuItem Header="EN" IsCheckable="True" IsChecked="{Binding IsEnglish}" />
                        <MenuItem Header="DE" IsCheckable="True" IsChecked="{Binding IsGerman}" />
                    </MenuItem>
                    <MenuItem Header="Theme">
                        <MenuItem Header="System" IsCheckable="True" IsChecked="{Binding IsSystemTheme}" />
                        <MenuItem Header="Dark" IsCheckable="True" IsChecked="{Binding IsDarkTheme}" />
                        <MenuItem Header="Light" IsCheckable="True" IsChecked="{Binding IsLightTheme}" />
                    </MenuItem>
                    <MenuItem Header="Font">
                        <MenuItem Header="Cascadia Code" IsCheckable="True" IsChecked="{Binding IsCascadiaCode}" />
                        <MenuItem Header="Verdana" IsCheckable="True" IsChecked="{Binding IsVerdana}" />
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Help" Style="{StaticResource MenuBarItem}">
                    <MenuItem Header="Check for updates" Command="{Binding CheckForUpdatesCommand}" />
                    <MenuItem Header="GitHub" Command="{Binding OpenUrlCommand}"
                              CommandParameter="https://github.com/Nephos-Bit/Bit.GrimmDiff" />
                </MenuItem>
            </Menu>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding WeeklyQuotaText}" Foreground="{DynamicResource Secondary}" FontSize="12"
                           ToolTip="{Binding WeeklyQuotaToolTip}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Style="{StaticResource HeaderAction}" Command="{Binding LoginToCodexCommand}"
                        ToolTip="{Binding CodexStatusText}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding CodexStatusBrush}" VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                        <TextBlock Text="{Binding CodexAccountText}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="300" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="440" MinWidth="280" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,1,0">
                    <StackPanel VerticalAlignment="Top">
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleRepositoryPanelCommand}"
                                CommandParameter="Toggle"
                                ToolTip="Repository information" AutomationProperties.Name="Repository information">
                            <Grid>
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Data="M15,4 L7,12 L15,20"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" Fill="Transparent" StrokeStartLineCap="Square"
                                      StrokeEndLineCap="Square">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRepositoryPanelExpanded}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Data="M9,4 L17,12 L9,20"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" Fill="Transparent" StrokeStartLineCap="Square"
                                      StrokeEndLineCap="Square">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRepositoryPanelExpanded}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                        <Button x:Name="BranchButton" Style="{StaticResource IconButton}"
                                ToolTip="{Binding BranchToolTip}"
                                AutomationProperties.Name="{Binding BranchToolTip}" IsEnabled="{Binding HasRepository}"
                                Command="{Binding OpenBranchMenuCommand}">
                            <Button.ContextMenu>
                                <ContextMenu
                                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                    PlacementTarget="{Binding ElementName=BranchButton}"
                                    IsOpen="{Binding IsBranchMenuOpen, Mode=TwoWay}"
                                    ItemsSource="{Binding Branches}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Name}" />
                                            <Setter Property="Command"
                                                    Value="{Binding DataContext.SwitchBranchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Active}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Data="M12,2 L20,6 L12,10 L4,6 Z M4,12 L12,16 L20,12 M4,18 L12,22 L20,18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent"
                                  StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding PullCommand}"
                                ToolTip="{Binding PullToolTip}" AutomationProperties.Name="{Binding PullToolTip}">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Data="M12,3 L12,18 M6,12 L12,18 L18,12 M4,21 L20,21"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent"
                                  StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                        </Button>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="160" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="REPOSITORY" Foreground="{DynamicResource Secondary}" FontSize="12" />
                        <TextBlock Grid.Row="1" Text="{Binding RepositoryName}" TextTrimming="CharacterEllipsis"
                                   Margin="0,8,0,24" />
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button Content="Current changes" Command="{Binding ShowCurrentCommand}"
                                    HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="1" Text="HISTORICAL COMMITS" Foreground="{DynamicResource Secondary}"
                                       FontSize="12" Margin="0,24,0,8" />
                            <ListBox Grid.Row="2" ItemsSource="{Binding History}"
                                     SelectedItem="{Binding SelectedCommit}" BorderThickness="0"
                                     Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding SubjectParts}" ClipToBounds="True">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <DockPanel LastChildFill="True" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.Resources>
                                                <DataTemplate DataType="{x:Type local:PlainCommitSubjectPartModel}">
                                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                                <DataTemplate DataType="{x:Type local:JiraCommitSubjectPartModel}">
                                                    <Button Content="{Binding Text}" Style="{StaticResource IssueLink}"
                                                            Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Url}" />
                                                </DataTemplate>
                                            </ItemsControl.Resources>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <TextBlock Grid.Row="3" Text="RECENT REPOSITORIES" Foreground="{DynamicResource Secondary}"
                                   FontSize="12" Margin="0,16,0,8" />
                        <ListBox Grid.Row="4" ItemsSource="{Binding RecentRepositories}"
                                 SelectedItem="{Binding SelectedRecent}" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <GridSplitter Grid.Column="2" Width="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource Border}" ShowsPreview="True" Cursor="SizeWE"
                              local:GridSplitterWidthBindingBehaviorControl.TargetColumnIndex="1"
                              local:GridSplitterWidthBindingBehaviorControl.PanelWidth="{Binding RepositoryPanelColumnWidth, Mode=TwoWay}">
                    <GridSplitter.Style>
                        <Style TargetType="GridSplitter">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRepositoryPanelExpanded}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </GridSplitter.Style>
                </GridSplitter>
                <Border Grid.Column="3" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,1,0" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Command="{Binding AnalyzeWithAiCommand}"
                                        ToolTip="{Binding AnalyzeButtonText}">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Data="M4,12 A8,8 0 0 1 18,6 M18,6 L18,2 M18,6 L14,6 M20,12 A8,8 0 0 1 6,18 M6,18 L6,22 M6,18 L10,18"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent"
                                          StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Command="{Binding CancelAnalysisCommand}"
                                        ToolTip="{Binding CancelButtonText}" Foreground="{DynamicResource Critical}">
                                    <Path Width="16" Height="16" Stretch="Uniform" Data="M6,6 L18,18 M18,6 L6,18"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent"
                                          StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
                                </Button>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ViewTitle}" TextTrimming="CharacterEllipsis" FontSize="20" />
                                <TextBlock Text="{Binding AnalysisProgressText}"
                                           Foreground="{DynamicResource Secondary}" FontSize="12" Margin="0,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar Grid.Row="1" Height="2" IsIndeterminate="True"
                                     Foreground="{DynamicResource Active}" Background="{DynamicResource Border}"
                                     BorderThickness="0" Margin="0,8,0,0">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox Grid.Row="0" ItemsSource="{Binding Groups}" BorderThickness="0"
                                     Background="Transparent" ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Expander IsExpanded="False" BorderBrush="{DynamicResource Border}"
                                                  BorderThickness="0,0,0,1" Padding="0,8"
                                                  HorizontalContentAlignment="Stretch">
                                            <Expander.Header>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="8" Height="8" Margin="0,4,8,0"
                                                             AutomationProperties.Name="{Binding ReviewAccessibilityLabel}">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasReview}"
                                                                            Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsReviewGood}"
                                                                            Value="True">
                                                                        <Setter Property="Fill"
                                                                                Value="{DynamicResource Positive}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsReviewOk}"
                                                                            Value="True">
                                                                        <Setter Property="Fill"
                                                                                Value="{DynamicResource Warning}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsReviewWarning}"
                                                                            Value="True">
                                                                        <Setter Property="Fill"
                                                                                Value="{DynamicResource Critical}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                                                   FontSize="14" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   Foreground="{DynamicResource Secondary}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Expander.Header>
                                            <ListBox ItemsSource="{Binding Files}" MaxHeight="260" Margin="16,4,0,2"
                                                     BorderThickness="0" Background="Transparent"
                                                     ScrollViewer.CanContentScroll="True"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource FileLink}"
                                                                Command="{Binding DataContext.SelectFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalAlignment="Stretch">
                                                            <TextBlock Text="{Binding Path}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Expander>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                                    Margin="0,16,0,0" Padding="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding AnalysisSourceLabel}"
                                               Foreground="{DynamicResource Secondary}"
                                               FontSize="11" />
                                    <TextBlock Text="{Binding AiStatusMessage}"
                                               Foreground="{DynamicResource Secondary}"
                                               FontSize="11" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding AiDisclosureText}"
                                               Foreground="{DynamicResource CodeComment}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Column="4" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="CODE" Foreground="{DynamicResource Secondary}" FontSize="12" />
                        <local:DiffViewerControl Grid.Row="1" RenderDocument="{Binding DisplayedDiff, Mode=OneWay}"
                                          BorderThickness="0" Background="Transparent"
                                          FontFamily="{DynamicResource AppFontFamily}" FontSize="13" Margin="0,16,0,0" />
                        <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"
                                Margin="0,16,0,0" Padding="0,16,0,0">
                            <StackPanel>
                                <Button Content="Weitere Änderungen laden" Command="{Binding LoadMoreDiffCommand}"
                                        HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMoreDiff}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedReview}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding SelectedReviewStatusText}" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelectedReviewGood}" Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Positive}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelectedReviewOk}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelectedReviewWarning}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Critical}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SelectedReviewHint}"
                                               Foreground="{DynamicResource Secondary}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSelectedReviewHint}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="{DynamicResource Secondary}"
                       Margin="0 5 0 0" />
        </Grid>
    </Grid>
</Window>
